function testJiraConnection() {
  const jiraBaseUrl =
    "https://glophics-team-tejd16ze.atlassian.net";

  const scriptProperties =
    PropertiesService.getScriptProperties();

  const jiraEmail =
    scriptProperties.getProperty("JIRA_EMAIL");

  const jiraApiToken =
    scriptProperties.getProperty("JIRA_API_TOKEN");

  if (!jiraEmail || !jiraApiToken) {
    throw new Error(
      "Please set JIRA_EMAIL and JIRA_API_TOKEN in Script Properties."
    );
  }

  const encodedCredentials =
    Utilities.base64Encode(
      jiraEmail + ":" + jiraApiToken
    );

  const requestOptions = {
    method: "get",
    headers: {
      Authorization: "Basic " + encodedCredentials,
      Accept: "application/json"
    },
    muteHttpExceptions: true
  };

  const response = UrlFetchApp.fetch(
    jiraBaseUrl + "/rest/api/3/myself",
    requestOptions
  );

  Logger.log(
    "Connection HTTP Status: " +
    response.getResponseCode()
  );

  if (response.getResponseCode() !== 200) {
    Logger.log(response.getContentText());
    throw new Error(
      "Jira authentication failed. Check your email, API token, and account access."
    );
  }

  Logger.log("Jira authentication successful.");
}


